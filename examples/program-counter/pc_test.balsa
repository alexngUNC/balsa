-- Simulation-only test harness; synthesize program_counter.balsa instead.
import [program_counter]
import [balsa.sim.sim]

procedure balsa_top is
  channel commands : PCCommand
  channel addresses : PCAddress
  variable actual : PCAddress
  variable failures : 8 bits
  variable stopped : bit
begin
  program_counter (commands, addresses) ||
  begin
    failures := 0;
    commands <- PCCommand {pcHold, 0};
    addresses -> actual;
    if actual /= 0 then failures := (failures + 1 as 8 bits) end;
    commands <- PCCommand {pcAdvance, 0};
    addresses -> actual;
    if actual /= 1 then failures := (failures + 1 as 8 bits) end;
    commands <- PCCommand {pcAdvance, 0};
    addresses -> actual;
    if actual /= 2 then failures := (failures + 1 as 8 bits) end;
    commands <- PCCommand {pcHold, 99};
    addresses -> actual;
    if actual /= 2 then failures := (failures + 1 as 8 bits) end;
    commands <- PCCommand {pcLoad, 254};
    addresses -> actual;
    if actual /= 254 then failures := (failures + 1 as 8 bits) end;
    commands <- PCCommand {pcAdvance, 0};
    addresses -> actual;
    if actual /= 255 then failures := (failures + 1 as 8 bits) end;
    commands <- PCCommand {pcAdvance, 0};
    addresses -> actual;
    if actual /= 0 then failures := (failures + 1 as 8 bits) end;
    commands <- PCCommand {pcLoad, 42};
    addresses -> actual;
    if actual /= 42 then failures := (failures + 1 as 8 bits) end;
    commands <- PCCommand {pcAdvance, 0};
    addresses -> actual;
    if actual /= 43 then failures := (failures + 1 as 8 bits) end;
    commands <- PCCommand {pcReset, 99};
    addresses -> actual;
    if actual /= 0 then failures := (failures + 1 as 8 bits) end;
    if failures = 0 then
      stopped := BalsaSimulationStop ()
    else
      halt
    end
  end
end
