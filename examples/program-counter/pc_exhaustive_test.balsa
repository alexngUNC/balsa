-- Check reset, hold, and advance from every possible 8-bit PC state.
-- Simulation only: a loop reuses the test logic rather than unrolling it.
import [program_counter]
import [balsa.sim.sim]

procedure balsa_top is
  channel commands : PCCommand
  channel addresses : PCAddress
  variable index : 9 bits
  variable actual, expected, ignoredTarget : PCAddress
  variable failed, stopped : bit
begin
  program_counter (commands, addresses) ||
  begin
    failed := 0;
    index := 0;
    loop while index < 256 then
      expected := (index as PCAddress);
      ignoredTarget := (255 - index as PCAddress);
      commands <- PCCommand {pcLoad, expected};
      addresses -> actual;
      if actual /= expected then failed := 1 end;

      commands <- PCCommand {pcHold, ignoredTarget};
      addresses -> actual;
      if actual /= expected then failed := 1 end;

      if index = 255 then expected := 0
      else expected := (index + 1 as PCAddress) end;
      commands <- PCCommand {pcAdvance, ignoredTarget};
      addresses -> actual;
      if actual /= expected then failed := 1 end;

      commands <- PCCommand {pcLoad, (index as PCAddress)};
      addresses -> actual;
      if actual /= (index as PCAddress) then failed := 1 end;
      commands <- PCCommand {pcReset, ignoredTarget};
      addresses -> actual;
      if actual /= 0 then failed := 1 end;

      index := (index + 1 as 9 bits)
    end;
    if not failed then stopped := BalsaSimulationStop () else halt end
  end
end
